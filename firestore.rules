rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validDifficulty(value) {
      return value == 6 || value == 9 || value == 12 || value == 24;
    }

    function validName(value) {
      return value is string && value.size() >= 1 && value.size() <= 24;
    }

    function validStatsShape(data) {
      return data.keys().hasOnly([
        'uid', 'displayName', 'difficulty', 'plays', 'clears',
        'lastStartedMatchId', 'lastCompletedMatchId', 'updatedAt'
      ])
      && data.uid == request.auth.uid
      && validName(data.displayName)
      && validDifficulty(data.difficulty)
      && data.plays is int && data.plays >= 1
      && data.clears is int && data.clears >= 0 && data.clears <= data.plays
      && data.lastStartedMatchId is string
      && data.lastCompletedMatchId is string
      && data.updatedAt == request.time;
    }

    match /rankedMatches/{matchId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'difficulty', 'status', 'startedAt'])
        && request.resource.data.uid == request.auth.uid
        && validDifficulty(request.resource.data.difficulty)
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt == request.time;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'finishedAt'])
        && request.resource.data.status in ['success', 'fail', 'abandoned']
        && request.resource.data.finishedAt == request.time;
      allow delete: if false;
    }

    match /rankedStats/{statsId} {
      allow read: if true;
      allow create: if signedIn()
        && validStatsShape(request.resource.data)
        && request.resource.data.plays == 1
        && request.resource.data.clears == 0
        && request.resource.data.lastCompletedMatchId == ''
        && getAfter(/databases/$(database)/documents/rankedMatches/$(request.resource.data.lastStartedMatchId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/rankedMatches/$(request.resource.data.lastStartedMatchId)).data.difficulty == request.resource.data.difficulty
        && getAfter(/databases/$(database)/documents/rankedMatches/$(request.resource.data.lastStartedMatchId)).data.status == 'active';
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validStatsShape(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.difficulty == resource.data.difficulty
        && (
          (
            request.resource.data.plays == resource.data.plays + 1
            && request.resource.data.clears == resource.data.clears
            && request.resource.data.lastCompletedMatchId == resource.data.lastCompletedMatchId
            && request.resource.data.lastStartedMatchId != resource.data.lastStartedMatchId
            && getAfter(/databases/$(database)/documents/rankedMatches/$(request.resource.data.lastStartedMatchId)).data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/rankedMatches/$(request.resource.data.lastStartedMatchId)).data.difficulty == request.resource.data.difficulty
            && getAfter(/databases/$(database)/documents/rankedMatches/$(request.resource.data.lastStartedMatchId)).data.status == 'active'
          )
          ||
          (
            request.resource.data.plays == resource.data.plays
            && request.resource.data.clears == resource.data.clears + 1
            && request.resource.data.lastStartedMatchId == resource.data.lastStartedMatchId
            && request.resource.data.lastCompletedMatchId != resource.data.lastCompletedMatchId
            && get(/databases/$(database)/documents/rankedMatches/$(request.resource.data.lastCompletedMatchId)).data.status == 'active'
            && getAfter(/databases/$(database)/documents/rankedMatches/$(request.resource.data.lastCompletedMatchId)).data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/rankedMatches/$(request.resource.data.lastCompletedMatchId)).data.difficulty == request.resource.data.difficulty
            && getAfter(/databases/$(database)/documents/rankedMatches/$(request.resource.data.lastCompletedMatchId)).data.status == 'success'
          )
        );
      allow delete: if false;
    }
  }
}
