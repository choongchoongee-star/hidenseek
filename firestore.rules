rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validName(value) {
      return value is string && value.size() >= 2 && value.size() <= 10;
    }

    function validScoreShape(data) {
      return data.keys().hasOnly([
        'uid', 'displayName', 'score', 'totalTimeMs', 'wrongGuesses', 'completedAt'
      ])
      && data.uid == request.auth.uid
      && validName(data.displayName)
      && data.score is int && data.score >= 0 && data.score <= 100000
      && data.totalTimeMs is int && data.totalTimeMs > 0 && data.totalTimeMs <= 86400000
      && data.wrongGuesses is int && data.wrongGuesses >= 0 && data.wrongGuesses <= 8
      && data.completedAt == request.time;
    }

    match /rankedScores/{uid} {
      allow read: if true;
      allow create: if signedIn()
        && uid == request.auth.uid
        && validScoreShape(request.resource.data);
      allow update: if signedIn()
        && uid == request.auth.uid
        && resource.data.uid == request.auth.uid
        && validScoreShape(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && (
          request.resource.data.score > resource.data.score
          || (request.resource.data.score == resource.data.score
            && request.resource.data.totalTimeMs < resource.data.totalTimeMs)
        );
      allow delete: if false;
    }

    match /rankedMatches/{document=**} {
      allow read, write: if false;
    }

    match /rankedStats/{document=**} {
      allow read, write: if false;
    }
  }
}
